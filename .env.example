# Reference list of environment variables. Nothing loads this file automatically:
# locally, set values in the terminal before starting; on Azure they live on the Container App.
# See docs/local.md and docs/deployment.md.

# --- Game API ---
PORT=8787
# Address to listen on. Unset: all interfaces. The Docker image sets 127.0.0.1 because nginx sits in front.
# LISTEN_HOST=127.0.0.1
# Dev-login (anonymous tokens signed by the API) is the only login. It is on by default only locally (no NODE_ENV=production).
# Online: ALLOW_DEV_AUTH=true plus a long random AUTH_SECRET, otherwise the API refuses to sign anyone in.
ALLOW_DEV_AUTH=true
AUTH_SECRET=dev-only-secret-change-me
INTERNAL_TICK_SECRET=dev-tick-secret
# Only needed when a website on another address calls the API (comma-separated for several).
# The Docker image serves website and API from one address, so leave it empty there.
CORS_ORIGIN=
PRESENTATION_MS=3000
PIPELINE_MS=1000
ANIMATION_MS=4000
GRACE_MS=30000
SESSION_TTL_HOURS=24
# Close and delete sessions with no commands/heartbeats for this long (ms). Default 30 minutes.
SESSION_IDLE_MS=1800000
# Max open (non-closed) sessions that may be created from one client IP.
# Unset: 10 with NODE_ENV=production, no cap locally. 0 turns the cap off.
# MAX_OPEN_SESSIONS_PER_IP=10
# How often changed sessions are written to Postgres (ms). New and closed sessions flush immediately.
# Keep this well above the 500 ms tick so idle games do not cause steady database traffic.
PERSIST_INTERVAL_MS=15000
# Optional: LOG_HTTP=all also logs successful HTTP (noisy; for debugging only). Default logs failures + key events.
# LOG_HTTP=all
# Optional path for the JSONL event log (default: next to GAME_FILE as api-events.jsonl,
# or data/api-events.jsonl when neither GAME_FILE nor DATABASE_URL is set).
# Pruned to the last 24 hours whenever a session is created or started — no cron.
# LOG_FILE=data/api-events.jsonl
#
# Session backup (pick at most one; memory is always the live source of truth):
# - Neither set: sessions live only in memory (Azure default). Lost on restart/deploy.
# - GAME_FILE only: local JSON file for surviving a local API restart. The API sets
#   GAME_FILE=data/game.json automatically when DATABASE_URL is unset.
# - DATABASE_URL: Postgres table session_documents. GAME_FILE is then left unset.
# Local Postgres from docker-compose.yml (npm run db:up):
# DATABASE_URL=postgresql://bdi:bdi@localhost:5432/bdi
# Azure (infra/main.bicep with enablePostgres=true builds this and stores it as a secret):
# DATABASE_URL=postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/bdi?sslmode=verify-full
# GAME_FILE=data/game.json

# --- Website (baked in at build time) ---
# Only VITE_* variables reach the browser. Never put a secret in one.
# Only needed when the API runs on another address than the website. Not used in the Docker image.
# VITE_API_URL=https://api.example.org
# Only needed when QR codes must point to a different address than the one the beamer opens.
# VITE_PUBLIC_BASE_URL=
# Local only: enables #/bootstrap. Never set it for a production build.
# VITE_ALLOW_DEV_AUTH=true
